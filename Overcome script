--// ============================================================
--// INPUT HANDLERS
--// ============================================================

local function inputMatches(input, bind)
    if not bind then return false end
    if input.KeyCode == bind then return true end
    if input.UserInputType == bind then return true end
    return false
end

UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    -- listening for keybind capture
    if listening then
        -- escape always cancels
        if input.KeyCode == Enum.KeyCode.Escape then
            listening = nil
            refreshBindWidgets()
            return
        end
        -- keyboard: bind
        if input.UserInputType == Enum.UserInputType.Keyboard then
            setBinding(listening, input.KeyCode)
            return
        end
        -- RMB/MMB: bind
        if input.UserInputType == Enum.UserInputType.MouseButton2
            or input.UserInputType == Enum.UserInputType.MouseButton3 then
            setBinding(listening, input.UserInputType)
            return
        end
        -- LMB: cancel (never bind LMB — breaks the menu)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            listening = nil
            refreshBindWidgets()
            return
        end
        return
    end

    -- menu toggle
    if Binding.menu and inputMatches(input, Binding.menu) then
        if setMenu then setMenu(not menuOpen) end
        return
    end

    -- feature keys
    if inputMatches(input, Binding.aim) then Aim.keyDown = true end
    if inputMatches(input, Binding.silent) then Silent.keyDown = true end
    if inputMatches(input, Binding.fly) then
        Player.fly = not Player.fly
        if Player.fly then startFly() else stopFly() end
    end
    if inputMatches(input, Binding.noclip) then Player.noclip = not Player.noclip end
    if inputMatches(input, Binding.dash) then doDash() end
end)

UIS.InputEnded:Connect(function(input)
    if inputMatches(input, Binding.aim) then Aim.keyDown = false end
    if inputMatches(input, Binding.silent) then Silent.keyDown = false end
    if inputMatches(input, Binding.sprint) then updateSpeedTotal() end
end)

-- click-off dropdown
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    if not activeDropdown or not activeDropdown.list then return end
    local list = activeDropdown.list
    if not list.Parent then activeDropdown = nil; return end
    local abs = list.AbsolutePosition
    local size = list.AbsoluteSize
    local p = input.Position
    local inside = p.X >= abs.X and p.X <= abs.X + size.X
        and p.Y >= abs.Y and p.Y <= abs.Y + size.Y
    if not inside then closeActiveDropdown() end
end)

