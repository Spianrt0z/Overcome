local function make(class, props, parent)
    local i = Instance.new(class)
    for k, v in pairs(props) do
        if k ~= "Parent" then i[k] = v end
    end
    if parent then i.Parent = parent end
    return i
end
local function corner(inst, r)
    return make("UICorner", { CornerRadius = UDim.new(0, r or 6) }, inst)
end
local function newGui(name, order)
    local g = make("ScreenGui", {
        Name = name, ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = order or 0,
    })
    local ok = pcall(function() g.Parent = parentGui end)
    if not ok then g.Parent = LP:WaitForChild("PlayerGui") end
    return g
end

