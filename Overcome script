local function doDash()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or Player.dashActive then return end
    Player.dashActive = true
    local bv = Instance.new("BodyVelocity")
    bv.Name = "outcome_dash"
    bv.MaxForce = Vector3.new(1e5, 0, 1e5)
    bv.Velocity = Camera.CFrame.LookVector * 120
    bv.Parent = hrp
    task.delay(0.2, function()
        if bv and bv.Parent then bv:Destroy() end
        Player.dashActive = false
    end)
end

local spectateConn
local function updateSpectate()
    if spectateConn then spectateConn:Disconnect(); spectateConn = nil end
    if not Teleport.spectate or Teleport.target == "None" then return end
    spectateConn = RunService.RenderStepped:Connect(function()
        local plr = Players:FindFirstChild(Teleport.target)
        if not plr then return end
        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        if head then Camera.CFrame = head.CFrame * CFrame.new(0, 1, 8) end
    end)
end

