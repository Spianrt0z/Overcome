local hudItems = {}

local function createHudItem(name, size, defaultPos, contentFn)
    local frame = make("Frame", {
        Size = size,
        Position = getgenv().outcome_hud[name] or defaultPos,
        BackgroundColor3 = Theme.panel,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        Visible = HUD[name] or false,
    }, hudGui)
    corner(frame, 6)
    make("UIStroke", { Color = Theme.stroke, Thickness = 1 }, frame)

    local content = make("TextLabel", {
        Size = UDim2.new(1, -16, 1, 0),
        Position = UDim2.fromOffset(8, 0),
        BackgroundTransparency = 1, Text = "",
        Font = Enum.Font.Gotham, TextSize = 12,
        TextColor3 = Theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, frame)

    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            getgenv().outcome_hud[name] = frame.Position
        end
    end)

    hudItems[name] = { frame = frame, label = content, update = contentFn }
    return hudItems[name]
end

