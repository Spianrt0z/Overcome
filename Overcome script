local function flingTarget(plr)
    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local bv = Instance.new("BodyAngularVelocity")
    bv.AngularVelocity = Vector3.new(9999, 9999, 9999)
    bv.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bv.Parent = hrp
    task.delay(1.5, function() if bv and bv.Parent then bv:Destroy() end end)
end
local function flingAll()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then flingTarget(plr) end
    end
end
local function bringAll()
    local myChar = LP.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame = myRoot.CFrame + Vector3.new(math.random(-4, 4), 2, math.random(-4, 4)) end
        end
    end
end
local function killAll()
    local myChar = LP.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hrp and hum then
                if firetouchinterest then
                    pcall(function()
                        firetouchinterest(myRoot, hrp, 0)
                        task.wait()
                        firetouchinterest(myRoot, hrp, 1)
                    end)
                end
                pcall(function() hum.Health = 0 end)
            end
        end
    end
end
local function freezeAll()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Anchored = true end
        end
    end
end
local function unfreezeAll()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Anchored = false end
        end
    end
end

