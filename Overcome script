setMenu = function(open)
    if not main or not main.Parent then return end
    menuOpen = open
    if not open then
        closeActiveDropdown()
        if listening then
            listening = nil
            refreshBindWidgets()
        end
    end
    if open then
        main.Visible = true
        scale.Scale = 0.85
        TS:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Scale = 1,
        }):Play()
    else
        TS:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
            Scale = 0.85,
        }):Play()
        task.delay(0.15, function() if not menuOpen and main then main.Visible = false end end)
    end
end

