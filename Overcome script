local bhopConn
local function toggleBhop(on)
    if bhopConn then bhopConn:Disconnect(); bhopConn = nil end
    if not on then return end
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local lastJump = 0
    bhopConn = hum.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Landed and tick() - lastJump > 0.05 then
            lastJump = tick()
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
end

local lowGravConn
local function toggleLowGravity(on)
    if lowGravConn then lowGravConn:Disconnect(); lowGravConn = nil end
    if on then
        lowGravConn = RunService.Heartbeat:Connect(function()
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local bf = hrp:FindFirstChild("outcome_lowgrav")
                if not bf then
                    bf = Instance.new("BodyForce")
                    bf.Name = "outcome_lowgrav"
                    bf.Force = Vector3.new(0, hrp.AssemblyMass * 100, 0)
                    bf.Parent = hrp
                end
            end
        end)
    else
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bf = hrp:FindFirstChild("outcome_lowgrav")
            if bf then bf:Destroy() end
        end
    end
