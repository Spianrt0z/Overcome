local function getChar(plr)
    local c = plr.Character
    if not c then return nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return nil end
    return c
end

local function getPartFor(char, name)
    if name == "Head" then return char:FindFirstChild("Head")
    elseif name == "Torso" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    elseif name == "LowerTorso" then return char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso")
    end
    return char:FindFirstChild("HumanoidRootPart")
end

local function visible(part)
    local origin = Camera.CFrame.Position
    local ray = Ray.new(origin, part.Position - origin)
    local ok, hit = pcall(function()
        return Workspace:FindPartOnRayWithIgnoreList(ray, { LP.Character, Camera })
    end)
    if not ok then return true end
    return hit == nil or hit:IsDescendantOf(part.Parent)
end

local function findTarget(fovRadius, partName, teamCheck, wallCheck)
    local bestPart, bestDist = nil, fovRadius
    local center = Camera.ViewportSize * 0.5
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = getChar(plr)
            if char then
                local skip = teamCheck and plr.Team ~= nil and plr.Team == LP.Team
                if not skip then
                    local part = getPartFor(char, partName)
                    if part then
                        local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen and sp.Z > 0 then
                            local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if d < bestDist then
                                if not wallCheck or visible(part) then
                                    bestPart, bestDist = part, d
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart
end

-- target-locking variant for aimbot
local function getLockedTarget(partName, teamCheck, wallCheck, fov)
    if Aim.targetLock and AimbotState.lockedPlr and AimbotState.lockedPart then
        local char = getChar(AimbotState.lockedPlr)
        local part = AimbotState.lockedPart
        if char and part and part.Parent == char then
            local sp, on = Camera:WorldToViewportPoint(part.Position)
            if on and sp.Z > 0 then
                local center = Camera.ViewportSize * 0.5
                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if d < fov * 1.5 then
                    if not wallCheck or visible(part) then
                        return part
                    end
                end
            end
        end
        AimbotState.lockedPlr = nil
        AimbotState.lockedPart = nil
    end
    -- find new
    local center = Camera.ViewportSize * 0.5
    local bestPart, bestDist, bestPlr = nil, fov, nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = getChar(plr)
            if char then
                local skip = teamCheck and plr.Team ~= nil and plr.Team == LP.Team
                if not skip then
                    local part = getPartFor(char, partName)
                    if part then
                        local sp, on = Camera:WorldToViewportPoint(part.Position)
                        if on and sp.Z > 0 then
                            local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if d < bestDist then
                                if not wallCheck or visible(part) then
                                    bestPart, bestDist, bestPlr = part, d, plr
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    AimbotState.lockedPart = bestPart
    AimbotState.lockedPlr = bestPlr
    return bestPart
end

local function getOtherPlayerNames()
    local names = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then table.insert(names, plr.Name) end
    end
    if #names == 0 then return { "None" } end
    return names
end

local function formatDist(n)
    if ESP.distanceFmt == "m" then return string.format("%.1fm", n / 3.571) end
    return string.format("[%d]", math.floor(n))
end

