local function updateSpeedTotal()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local base = Player.speedOn and Player.speed or Player.baseSpeed
    if Player.sprintOn and UIS:IsKeyDown(Binding.sprint or Enum.KeyCode.LeftShift) then
        base = base + Player.sprintAdd
    end
    hum.WalkSpeed = base
end

local function updateJumpTotal()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.UseJumpPower = true
    local base = Player.jumpOn and Player.jump or Player.baseJump
    if Player.highJump then base = base * 2 end
    hum.JumpPower = base
end

local function applyInvisible()
    local char = LP.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.Transparency = Player.invisible and 1 or 0 end
        if part:IsA("Decal") then part.Transparency = Player.invisible and 1 or 0 end
    end
end
local function applyHipHeight()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.HipHeight = Player.hipHeight end
end

local flyBV, flyBG
local function stopFly()
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyBG then flyBG:Destroy(); flyBG = nil end
    Player.flyActive = false
end
local function startFly()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    stopFly()
    flyBV = Instance.new("BodyVelocity")
    flyBV.Name = "outcome_fly"
    flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    flyBV.Velocity = Vector3.zero
    flyBV.Parent = root
    flyBG = Instance.new("BodyGyro")
    flyBG.Name = "outcome_fly"
    flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    flyBG.P = 2500
    flyBG.CFrame = root.CFrame
    flyBG.Parent = root
    Player.flyActive = true
end
local function updateFly()
    if not flyBV or not flyBV.Parent then return end
    local dir = Vector3.zero
    local camCF = Camera.CFrame
    if UIS:IsKeyDown(Enum.KeyCode.W) then dir += camCF.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= camCF.LookVector end
    if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= camCF.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.D) then dir += camCF.RightVector end
    if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.new(0, 1, 0) end
    flyBV.Velocity = dir.Magnitude > 0 and dir.Unit * Player.flySpeed or Vector3.zero
    if flyBG then flyBG.CFrame = CFrame.new(flyBG.CFrame.Position, flyBG.CFrame.Position + camCF.LookVector) end
end

local function applyNoclip()
    local char = LP.Character
    if not char then return end
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end
end

local hitboxConn
local function toggleHitbox(on)
    if hitboxConn then hitboxConn:Disconnect(); hitboxConn = nil end
    if not on then
        for _, plr in ipairs(Players:GetPlayers()) do
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp and hrp:GetAttribute("outcome_hb") then
                hrp.Size = Vector3.new(2, 2, 1)
                hrp:SetAttribute("outcome_hb", nil)
            end
        end
        return
    end
    hitboxConn = RunService.Heartbeat:Connect(function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP then
                local char = plr.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.Size = Vector3.new(Hitbox.size, Hitbox.size, Hitbox.size)
                    hrp:SetAttribute("outcome_hb", true)
                    hrp.CanCollide = false
                end
            end
        end
    end)
end

local fbConn, origAmbient, origOutdoor, origBrightness
local function toggleFullbright(on)
    if fbConn then fbConn:Disconnect(); fbConn = nil end
    if on then
        origAmbient = Lighting.Ambient
        origOutdoor = Lighting.OutdoorAmbient
        origBrightness = Lighting.Brightness
        fbConn = RunService.Heartbeat:Connect(function()
            Lighting.Ambient = Color3.fromRGB(178, 178, 178)
            Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
            Lighting.Brightness = 3
            Lighting.FogEnd = 1e6; Lighting.FogStart = 1e6
        end)
    else
        if origAmbient then Lighting.Ambient = origAmbient end
        if origOutdoor then Lighting.OutdoorAmbient = origOutdoor end
        if origBrightness then Lighting.Brightness = origBrightness end
        Lighting.FogEnd = 100000; Lighting.FogStart = 0
    end
end

