-- main aimbot/render loop
RunService.RenderStepped:Connect(function(dt)
    if Drawing then
        for _, plr in ipairs(Players:GetPlayers()) do
            pcall(updateESP, plr)
        end
    end

    if fovCircle then
        local showAim = Aim.enabled and Aim.showFov
        local showSil = Silent.enabled and Silent.showFov
        local show = showAim or showSil
        fovCircle.Visible = show
        if show then
            local vp = Camera.ViewportSize
            fovCircle.Position = vp * 0.5
            fovCircle.Radius = showAim and Aim.fov or Silent.fov
            fovCircle.Color = showAim and Theme.accent or Theme.accent2
        end
    end

    -- AIMBOT
    if Aim.enabled and (not Aim.hold or Aim.keyDown) then
        local part = getLockedTarget(Aim.part, Aim.teamCheck, Aim.wallCheck, Aim.fov)
        if part then
            local camPos = Camera.CFrame.Position
            -- prediction
            local aimPos = part.Position
            if Aim.prediction > 0 then
                local vel = part.AssemblyLinearVelocity or Vector3.zero
                local dist = (aimPos - camPos).Magnitude
                local travelTime = dist / math.max(Aim.projectileSpeed, 100)
                aimPos = aimPos + vel * travelTime * (Aim.prediction / 100)
            end

            if Aim.mode == "Camera" then
                local goal = CFrame.new(camPos, aimPos)
                local currentLook = Camera.CFrame.LookVector
                local targetLook = (aimPos - camPos).Unit
                local dot = math.clamp(currentLook:Dot(targetLook), -1, 1)
                local angle = math.acos(dot)

                if angle > math.pi / 2 then
                    -- target behind, snap
                    Camera.CFrame = goal
                elseif angle < 0.05 then
                    -- on target, snap
                    Camera.CFrame = goal
                else
                    -- eased lerp
                    local s = math.clamp(Aim.smooth / 100, 0, 0.99)
                    -- exponential speed: low s = fast, high s = slow
                    local baseSpeed = math.pow(1 - s, 2)
                    -- angle boost: 0.6x when close, up to 3x when far
                    local angleMult = math.clamp(0.6 + angle * 1.5, 0.6, 3)
                    -- frame independent
                    local alpha = math.clamp(baseSpeed * angleMult * dt * 60, 0.02, 1)
                    Camera.CFrame = Camera.CFrame:Lerp(goal, alpha)
                end
            elseif Aim.mode == "Instant" then
                Camera.CFrame = CFrame.new(camPos, aimPos)
            elseif Aim.mode == "Mouse" and mousemoverel then
                local screen, on = Camera:WorldToViewportPoint(aimPos)
                if on then
                    local vp = Camera.ViewportSize
                    local dx = (screen.X - vp.X * 0.5) * (Aim.mouseStrength * 0.02)
                    local dy = (screen.Y - vp.Y * 0.5) * (Aim.mouseStrength * 0.02)
                    pcall(mousemoverel, dx, dy)
                end
            end
        else
            AimbotState.lockedPlr = nil
            AimbotState.lockedPart = nil
        end
    end

    if Player.fly then updateFly() end
end)

