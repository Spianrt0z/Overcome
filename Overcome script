end

local function createDropdown(page, label, optionsOrFn, default, callback)
    local row = newRow(page, 34)
    make("TextLabel", {
        Size = UDim2.new(0.5, 0, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1, Text = label,
        Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local valueBtn = make("TextButton", {
        Size = UDim2.new(0.45, 0, 0, 22),
        Position = UDim2.new(1, -12, 0.5, -11),
        AnchorPoint = Vector2.new(1, 0),
        BackgroundColor3 = Theme.panelHi, BorderSizePixel = 0,
        Text = default, Font = Enum.Font.Gotham, TextSize = 12,
        TextColor3 = Theme.accent, AutoButtonColor = false,
    }, row)
    corner(valueBtn, 5)
    local current = default
    local function setValue(v)
        current = v
        valueBtn.Text = v
        if callback then callback(v) end
    end
    valueBtn.MouseButton1Click:Connect(function()
        if activeDropdown and activeDropdown.btn == valueBtn then
            closeActiveDropdown(); return
        end
        closeActiveDropdown()
        local options = (type(optionsOrFn) == "function") and optionsOrFn() or optionsOrFn
        if not options or #options == 0 then return end
        local abs = valueBtn.AbsolutePosition
        local absSize = valueBtn.AbsoluteSize
        local rowHeight = 24
        local listHeight = #options * rowHeight + 6
        local screenH = Camera.ViewportSize.Y
        local openBelow = (abs.Y + absSize.Y + listHeight + 4) < screenH
        local yPos = openBelow and (abs.Y + absSize.Y + 4) or (abs.Y - listHeight - 4)
        local list = make("Frame", {
            Size = UDim2.fromOffset(absSize.X, listHeight),
            Position = UDim2.fromOffset(abs.X, yPos),
            BackgroundColor3 = Theme.panelHi, BorderSizePixel = 0, ZIndex = 200,
        }, menuGui)
        corner(list, 5)
        make("UIStroke", { Color = Theme.stroke, Thickness = 1, ZIndex = 201 }, list)
        make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, list)
        make("UIPadding", {
            PaddingTop = UDim.new(0, 3), PaddingLeft = UDim.new(0, 3),
            PaddingRight = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3),
        }, list)
        for i, opt in ipairs(options) do
            local ob = make("TextButton", {
                Size = UDim2.new(1, -6, 0, rowHeight - 2),
                BackgroundColor3 = (opt == current) and Theme.accent or Theme.panel,
                BackgroundTransparency = (opt == current) and 0.7 or 1,
                BorderSizePixel = 0, Text = opt,
                Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.text,
                ZIndex = 202, AutoButtonColor = false, LayoutOrder = i,
            }, list)
            corner(ob, 4)
            ob.MouseButton1Click:Connect(function()
                setValue(opt)
                closeActiveDropdown()
            end)
        end
        activeDropdown = { btn = valueBtn, list = list }
    end)
    return { Row = row, Set = setValue, Get = function() return current end }
end

local function createKeybind(page, label, bindName)
    local row = newRow(page, 34)
    make("TextLabel", {
        Size = UDim2.new(0.5, 0, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        BackgroundTransparency = 1, Text = label,
        Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local btn = make("TextButton", {
        Size = UDim2.new(0.32, 0, 0, 22),
        Position = UDim2.new(1, -68, 0.5, -11),
        AnchorPoint = Vector2.new(1, 0),
        BackgroundColor3 = Theme.panelHi, BorderSizePixel = 0,
        Text = keyName(Binding[bindName]),
        Font = Enum.Font.Gotham, TextSize = 12,
        TextColor3 = Theme.accent, AutoButtonColor = false,
    }, row)
    corner(btn, 5)
    local stroke = make("UIStroke", {
        Color = Theme.accent, Thickness = 1, Transparency = 1,
    }, btn)

    local function refresh()
        if listening == bindName then
            btn.Text = "press key..."
            btn.TextColor3 = Theme.good
            stroke.Transparency = 0
        else
            btn.Text = keyName(Binding[bindName])
            btn.TextColor3 = Theme.accent
            stroke.Transparency = 1
        end
    end
    refresh()
    bindWidgets[bindName] = { Refresh = refresh }

    btn.MouseButton1Click:Connect(function()
        if listening == bindName then
            listening = nil
            refreshBindWidgets()
        else
            listening = bindName
            refreshBindWidgets()
        end
    end)

    local clear = make("TextButton", {
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(1, -40, 0.5, -10),
        BackgroundTransparency = 1, Text = "×",
        Font = Enum.Font.GothamBold, TextSize = 14,
        TextColor3 = Theme.sub, AutoButtonColor = false,
    }, row)
    clear.MouseButton1Click:Connect(function()
        setBinding(bindName, nil)
    end)
    return { Row = row }
end

