local espObjects = {}
local highlights = {}

local function espBoxColor(hum)
    if not ESP.useHealthColor or not hum then return Theme.accent end
    local frac = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
    if frac > 0.66 then return Color3.fromRGB(90, 235, 140)
    elseif frac > 0.33 then return Color3.fromRGB(255, 200, 90)
    else return Color3.fromRGB(255, 92, 92) end
end

local function buildESP(plr)
    if not Drawing then return nil end
    local d = {}
    for i = 1, 4 do
        d["box" .. i] = Drawing.new("Line")
        d["box" .. i].Thickness = 1
        d["box" .. i].Color = Theme.accent
        d["box" .. i].Transparency = 1
        d["box" .. i].Visible = false
    end
    d.fill = Drawing.new("Quad")
    d.fill.Color = Theme.accent
    d.fill.Filled = true
    d.fill.Transparency = 0.5
    d.fill.Visible = false
    d.name = Drawing.new("Text")
    d.name.Size = 13; d.name.Center = true; d.name.Outline = true
    d.name.Color = Color3.fromRGB(255, 255, 255); d.name.Visible = false
    d.dist = Drawing.new("Text")
    d.dist.Size = 13; d.dist.Center = true; d.dist.Outline = true
    d.dist.Color = Theme.accent2; d.dist.Visible = false
    d.hpBg = Drawing.new("Line")
    d.hpBg.Thickness = 3; d.hpBg.Color = Color3.fromRGB(40, 40, 50); d.hpBg.Visible = false
    d.hp = Drawing.new("Line")
    d.hp.Thickness = 3; d.hp.Color = Theme.good; d.hp.Visible = false
    d.hpTxt = Drawing.new("Text")
    d.hpTxt.Size = 11; d.hpTxt.Center = true; d.hpTxt.Outline = true
    d.hpTxt.Color = Theme.text; d.hpTxt.Visible = false
    d.tracer = Drawing.new("Line")
    d.tracer.Thickness = 1; d.tracer.Color = Theme.accent; d.tracer.Visible = false
    espObjects[plr] = d
    return d
end

local function destroyESP(plr)
    local d = espObjects[plr]
    if d then
        for _, v in pairs(d) do pcall(function() v:Remove() end) end
        espObjects[plr] = nil
    end
    local h = highlights[plr]
    if h then pcall(function() h:Destroy() end) highlights[plr] = nil end
end

local function hideESP(d)
    for i = 1, 4 do d["box" .. i].Visible = false end
    d.fill.Visible = false
    d.name.Visible = false; d.dist.Visible = false
    d.hpBg.Visible = false; d.hp.Visible = false; d.hpTxt.Visible = false
    d.tracer.Visible = false
end

local function updateESP(plr)
    local d = espObjects[plr] or buildESP(plr)
    if not d then return end
    local char = getChar(plr)
    if not ESP.enabled or not char or plr == LP then
        hideESP(d)
        local h = highlights[plr]; if h then h.Enabled = false end
        return
    end
    if ESP.teamCheck and plr.Team ~= nil and plr.Team == LP.Team then
        hideESP(d)
        local h = highlights[plr]; if h then h.Enabled = false end
        return
    end
    local head = char:FindFirstChild("Head")
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not head or not root or not hum then hideESP(d) return end
    local myPos = Camera.CFrame.Position
    local dist = (root.Position - myPos).Magnitude
    if dist > ESP.maxDist then hideESP(d) return end
    local topScreen, topOn = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.55, 0))
    local botScreen, botOn = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
    if not (topOn and botOn and topScreen.Z > 0) then hideESP(d) return end
    local topV = Vector2.new(topScreen.X, topScreen.Y)
    local botV = Vector2.new(botScreen.X, botScreen.Y)
    local bh = math.abs(botV.Y - topV.Y)
    local bw = bh * 0.52
    local cx = (topV.X + botV.X) * 0.5
    local tl = Vector2.new(cx - bw / 2, topV.Y)
    local tr = Vector2.new(cx + bw / 2, topV.Y)
    local bl = Vector2.new(cx - bw / 2, botV.Y)
    local br = Vector2.new(cx + bw / 2, botV.Y)

    local color = espBoxColor(hum)
    for i = 1, 4 do d["box" .. i].Color = color end
    d.fill.Color = color

    if ESP.box then
        if ESP.style == "Full" then
            d.box1.From, d.box1.To = tl, tr
            d.box2.From, d.box2.To = tr, br
            d.box3.From, d.box3.To = br, bl
            d.box4.From, d.box4.To = bl, tl
            for i = 1, 4 do d["box" .. i].Visible = true end
        else
            local len = math.min(bw * 0.28, bh * 0.18)
            d.box1.From, d.box1.To = tl + Vector2.new(0, len), tl
            d.box2.From, d.box2.To = tl, tl + Vector2.new(len, 0)
            d.box3.From, d.box3.To = tr + Vector2.new(0, len), tr
            d.box4.From, d.box4.To = tr, tr + Vector2.new(-len, 0)
            for i = 1, 4 do d["box" .. i].Visible = true end
        end
        if ESP.filled then
            d.fill.PointA = tl; d.fill.PointB = tr
            d.fill.PointC = br; d.fill.PointD = bl
            d.fill.Transparency = ESP.fillTransparency
            d.fill.Visible = true
        else d.fill.Visible = false end
    else
        for i = 1, 4 do d["box" .. i].Visible = false end
        d.fill.Visible = false
    end

    if ESP.name then
        d.name.Text = plr.Name
        d.name.Position = Vector2.new(cx, topV.Y - 17)
        d.name.Visible = true
    else d.name.Visible = false end
    if ESP.distance then
        d.dist.Text = formatDist(dist)
        d.dist.Position = Vector2.new(cx, botV.Y + 2)
        d.dist.Visible = true
    else d.dist.Visible = false end
    if ESP.health then
        local frac = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        local x = cx - bw / 2 - 6
        d.hpBg.From = Vector2.new(x, topV.Y)
        d.hpBg.To = Vector2.new(x, botV.Y)
        d.hp.From = Vector2.new(x, botV.Y - bh * frac)
        d.hp.To = Vector2.new(x, botV.Y)
        d.hp.Color = color
        d.hpBg.Visible = true; d.hp.Visible = true
    else d.hpBg.Visible = false; d.hp.Visible = false end
    if ESP.healthText then
        d.hpTxt.Text = tostring(math.floor(hum.Health))
        d.hpTxt.Position = Vector2.new(cx - bw / 2 - 20, topV.Y + bh / 2 - 6)
        d.hpTxt.Visible = true
    else d.hpTxt.Visible = false end
    if ESP.tracer then
        local vp = Camera.ViewportSize
        d.tracer.From = Vector2.new(vp.X / 2, vp.Y)
        d.tracer.To = Vector2.new(cx, botV.Y)
        d.tracer.Visible = true
    else d.tracer.Visible = false end

    local hl = highlights[plr]
    if ESP.chams then
        if not hl or hl.Parent ~= char then
            if hl then hl:Destroy() end
            hl = Instance.new("Highlight")
            hl.Name = "outcome_cham"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillColor = Theme.accent
            hl.FillTransparency = 0.65
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.OutlineTransparency = 1
            hl.Parent = char
            highlights[plr] = hl
        end
        hl.Enabled = true
    elseif hl then hl.Enabled = false end
end

